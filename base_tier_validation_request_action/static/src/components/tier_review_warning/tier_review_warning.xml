<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="base_tier_validation.Collapse" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('panel-group')]/div[hasclass('panel')]" position="before">
            <t
                t-foreach="_getWarningReviews()"
                t-as="warning_review"
                t-key="warning_review.id"
            >
                <div class="alert alert-warning mb-2" role="alert">
                    <strong t-out="warning_review.name" />:
                    <span t-out="warning_review.constraint_message" />
                </div>
            </t>
        </xpath>
    </t>
</templates>
